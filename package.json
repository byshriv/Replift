{
  "name": "replift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:stress": "vitest run tests/stress",
    "test:browser": "playwright test",
    "baseline:verify": "node scripts/baseline.mjs",
    "check": "npm run baseline:verify && npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:stress && npm run build",
    "reference": "node scripts/reference-server.mjs",
    "artifacts": "node scripts/package-artifacts.mjs",
    "android:prepare": "npm run build && cap sync android",
    "android:debug": "npm run android:prepare && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:prepare && node scripts/android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.0",
    "@fontsource/rethink-sans": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
